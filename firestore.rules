rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (request.auth.token.role == 'admin' ||
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          getUserData().role == 'admin'));
    }

    // IST is UTC + 5h30m. 21:00 IST = 15:30 UTC.
    function isBeforeIstCutoff() {
      let utcHours = request.time.toMillis() / 1000 / 3600 % 24;
      let utcMinutes = request.time.toMillis() / 1000 / 60 % 60;
      return (utcHours < 15) || (utcHours == 15 && utcMinutes < 30);
    }

    // Public Payment & App Config (public keyId only; secrets stay in server-only /secrets)
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Server-only secrets (never readable by clients)
    match /secrets/{docId} {
      allow read, write: if false;
    }

    // User Profiles: strict owner or admin read/write (no cross-user PII scraping)
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) &&
        (!('role' in request.resource.data) || request.resource.data.role == 'customer');
      allow update: if isAdmin() ||
        (isOwner(userId) &&
         (!('role' in request.resource.data) || request.resource.data.role == resource.data.role));
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Delivery Clusters
    match /clusters/{clusterId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Pass Subscriptions: created/updated ONLY via trusted Cloud Functions (Admin SDK)
    match /passes/{passId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // Meal Tickets Ledger: created via Cloud Functions; customer can swap combo before 21:00 IST
    match /meal_tickets/{ticketId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (isOwner(resource.data.userId) &&
         isBeforeIstCutoff() &&
         resource.data.status == 'SCHEDULED' &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comboSelection', 'addOns']));
    }

    // Kitchen Batches
    match /kitchen_batches/{batchId} {
      allow read, write: if isAdmin();
    }

    // Partner Tiffin Kitchens & Menus
    match /tiffin_shops/{shopId} {
      allow read: if true;
      allow write: if isAdmin();

      match /dishes/{dishId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // Promotional Offers & Banners
    match /offers/{offerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Customer Orders Ledger: created ONLY via Cloud Functions after payment verification
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // FCM Device Tokens: strict owner write, admin read
    match /fcm_tokens/{tokenId} {
      allow read: if isAdmin();
      allow create, update: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // Abandoned Cart Recovery Sessions: owner or admin only
    match /abandoned_carts/{cartId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create, update: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // Admin Push Notifications Dispatch Queue & History: Admin only (stops anonymous spam!)
    match /notifications_queue/{queueId} {
      allow read, write: if isAdmin();
    }

    match /notifications_history/{historyId} {
      allow read, write: if isAdmin();
    }
  }
}
